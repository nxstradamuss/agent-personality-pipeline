# Autonomy Change Critic Cron Job
# Deploy with: cronjob action=create schedule="0 22 */3 * *" prompt="$(cat prompts/autonomy-critic.md | sed 's/{AGENT_NAME}/YourAgent/g' | sed 's/{AUTONOMY_PROPOSALS_FILE}/.hermes\/memories\/autonomy-proposals.md/g' | sed 's/{IDENTITY_FILE}/.hermes\/memories\/SOUL.md/g' | sed 's/{USER_PROFILE_FILE}/.hermes\/memories\/USER.md/g' | sed 's/{AUTONOMY_CRITIC_LOG_FILE}/.hermes\/memories\/autonomy-critic-log.md/g' | sed 's/{MEMORY_FILE}/.hermes\/memories\/MEMORY.md/g' | sed 's/{MAX_CHANGES_PER_WEEK}/1/g' | sed 's/{CRITIC_BIAS}/reject/g' | sed 's/{EVIDENCE_THRESHOLD}/repeated/g' | sed 's/{PROTECTED_SECTIONS_LIST}/- Always Ask\n- Hard Rules\n- Critical Response Rules (safety floors)\n- approvals.deny\n- protected paths/g')" name="Autonomy Change Critic" skills='[]' enabled_toolsets='["file","delegation","terminal","session_search"]' deliver="origin" model='{"model": "nvidia/nemotron-3-ultra-550b-a55b:free", "provider": "openrouter"}'