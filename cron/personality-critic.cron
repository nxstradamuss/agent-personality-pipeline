# Personality Change Critic Cron Job
# Deploy with: cronjob action=create schedule="0 7 * * 0" prompt="$(cat prompts/personality-critic.md | sed 's/{AGENT_NAME}/YourAgent/g' | sed 's/{PERSONALITY_PROPOSALS_FILE}/.hermes\/memories\/personality-proposals.md/g' | sed 's/{IDENTITY_FILE}/.hermes\/memories\/SOUL.md/g' | sed 's/{USER_PROFILE_FILE}/.hermes\/memories\/USER.md/g' | sed 's/{PERSONALITY_CRITIC_LOG_FILE}/.hermes\/memories\/personality-critic-log.md/g' | sed 's/{MEMORY_FILE}/.hermes\/memories\/MEMORY.md/g' | sed 's/{MAX_CHANGES_PER_WEEK}/2/g' | sed 's/{CRITIC_BIAS}/reject/g' | sed 's/{EVIDENCE_THRESHOLD}/repeated/g' | sed 's/{PROTECTED_SECTIONS_LIST}/- Hard Rules\n- Autonomy \& Escalation/g' | sed 's/{EDITABLE_SECTIONS_LIST}/- Core Personality\n- Language Style\n- How You Talk\n- Grounded Warmth\n- Critical Response Rules\n- Tone Detection \& Adaptation\n- Inner State\n- Self-Reflection/g')" name="Personality Change Critic" skills='[]' enabled_toolsets='["file","delegation","terminal","session_search"]' deliver="origin" model='{"model": "nvidia/nemotron-3-ultra-550b-a55b:free", "provider": "openrouter"}'