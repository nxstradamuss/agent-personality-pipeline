# Autonomy Maturation Review Cron Job
# Deploy with: cronjob action=create schedule="0 21 */3 * *" prompt="$(cat prompts/autonomy-review.md | sed 's/{AGENT_NAME}/YourAgent/g' | sed 's/{IDENTITY_FILE}/.hermes\/memories\/SOUL.md/g' | sed 's/{USER_PROFILE_FILE}/.hermes\/memories\/USER.md/g' | sed 's/{RUNTIME}/Hermes/g' | sed 's/{REVIEW_WINDOW}/3/g' | sed 's/{AUTONOMY_PROPOSALS_FILE}/.hermes\/memories\/autonomy-proposals.md/g' | sed 's/{MEMORY_FILE}/.hermes\/memories\/MEMORY.md/g')" name="Autonomy Maturation Review" skills='[]' enabled_toolsets='["file","delegation","terminal","session_search"]' deliver="local" model='{"model": "nvidia/nemotron-3-ultra-550b-a55b:free", "provider": "openrouter"}'